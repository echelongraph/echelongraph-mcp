# echelon-mcp-remote: the hosted, keyless remote MCP endpoint (#2316).
#
# Serves dist/http.js — Streamable HTTP over the SAME tool module (dist/index.js) the npm package
# ships, so the remote and the npm server cannot drift apart. Built by
# infrastructure/cloudrun/deploy-all.sh with SVC_CONTEXT[mcp-remote]=mcp-server, so every COPY
# below is relative to mcp-server/. Signed after push like every image deploy-all.sh builds.
# Named Dockerfile.http (SVC_DOCKERFILE[mcp-remote]) because mcp-server/Dockerfile is the stdio
# image the Docker MCP Catalog builds from the public repo's root (#2723).
#
# The lockfile is the source of the dependency set (npm ci), as for the npm release.

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
RUN npm ci --ignore-scripts
COPY src ./src
RUN npm run build && npm prune --omit=dev

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
# package.json is read at start-up: the server's name and version (serverInfo, /health and the
# API User-Agent) come from it.
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
USER node
# Cloud Run sets PORT; 8080 is the default in http.ts and SVC_PORT[mcp-remote].
EXPOSE 8080
# --max-old-space-size=128 (#2773): half of the instance's 256 MiB (deploy-all.sh SVC_MEMORY).
# Node 22 sizes V8's heap from the memory the system reports, not from a cgroup's limit: in a
# 256 MiB cgroup on a 16 GB host it allowed 8,195 MiB, so garbage piled up uncollected until the
# kernel killed the instance with every request on it. Capped, V8 collects first; the rest of the
# 256 MiB is the young generation, buffers and the runtime itself. What Cloud Run's instance
# reports is not verified (one that reports 256 MiB gets a default near this cap already): the
# start-up line's heap_limit_mb says what a revision runs with. httpPolicy.ts "Requests in flight
# per instance" has the measurements, and test/http-memory.test.mjs runs http.js with these flags.
# --max-semi-space-size=16 pins the young generation at Node 22's own default, so the heap limit
# is 176 MiB on Node 22 AND on Node 24. Node 24 sizes the semi-space from the host as well: with
# the old-space cap alone it allowed 320 MiB, over the 256 MiB instance (measured 2026-10-05,
# v8 heap_size_limit; the v2.6.4 Release run, on Node 24, failed http-memory.test.mjs on it).
CMD ["node", "--max-old-space-size=128", "--max-semi-space-size=16", "dist/http.js"]
