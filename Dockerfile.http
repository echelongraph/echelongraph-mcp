# echelon-mcp-remote: the hosted, keyless remote MCP endpoint (#2316).
#
# Serves dist/http.js — Streamable HTTP over the SAME tool module (dist/index.js) the npm package
# ships, so the remote and the npm server cannot drift apart. Built by
# infrastructure/cloudrun/deploy-all.sh with SVC_CONTEXT[mcp-remote]=mcp-server, so every COPY
# below is relative to mcp-server/. Signed after push like every image deploy-all.sh builds.
# Named Dockerfile.http (SVC_DOCKERFILE[mcp-remote]) because mcp-server/Dockerfile is the stdio
# image the Docker MCP Catalog builds from the public repo's root (#2723).
#
# The lockfile is the source of the dependency set (npm ci), as for the npm release.
#
# Base: node 22.23.3 on Alpine 3.24, pinned by its multi-platform index digest (#3018), the base
# mcp-server/Dockerfile pins: on 2026-10-18 the tag node:22-alpine, which this file named with no
# digest until then, resolved to it (registry-1.docker.io). A moving tag let two deploys of one
# commit ship different base images with no record of the difference. Written on each FROM line,
# not as an ARG, so no --build-arg can swap it. To move it, resolve the new tag's index digest and
# change both FROM lines here and NODE_IMAGE in Dockerfile together (a base with a fixed HIGH or
# CRITICAL is what deploy-all.sh's Trivy scan refuses, #3018); test/dockerfile-base.test.mjs holds
# the two files to one pinned base.
FROM node:22.23.3-alpine3.24@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
RUN npm ci --ignore-scripts
COPY src ./src
RUN npm run build && npm prune --omit=dev

FROM node:22.23.3-alpine3.24@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402
ENV NODE_ENV=production
# #3345: the base image's own npm, npx and corepack leave the runtime stage. Nothing here runs them:
# the CMD below is node on dist/http.js, Cloud Run's probe is an HTTP GET of /health
# (deploy-all.sh), and the dependencies were installed and pruned in the build stage. The npm the
# base bundles is not in package-lock.json and carried 10 of the 13 fixable HIGH vulnerabilities
# #3018's Trivy gate refused the 3.1.0 image for (brace-expansion 2.0.2, ip-address 10.1.0, pacote
# 19.0.2 and 20.0.1, picomatch 4.0.3, sigstore 3.1.0; the other 3 were the SDK's and zod's, fixed
# by package-lock.json). The check after rm fails the build if a later base keeps any of them
# elsewhere on PATH or in the global node_modules. test/dockerfile-base.test.mjs holds this stage
# to it. The build stage keeps npm: it runs npm ci, build and prune.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
 && ! command -v npm && ! command -v npx && ! command -v corepack \
 && [ -z "$(ls -A /usr/local/lib/node_modules 2>/dev/null)" ]
WORKDIR /app
# package.json is read at start-up: the server's name and version (serverInfo, /health and the
# API User-Agent) come from it.
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
USER node
# Cloud Run sets PORT; 8080 is the default in http.ts and SVC_PORT[mcp-remote].
EXPOSE 8080
# --max-old-space-size=104 (#2773, #3132): under half of the instance's 256 MiB (deploy-all.sh SVC_MEMORY).
# It was 128 until 3.0.2. Once each tool's output schema was built once per process, not per
# request, the memory test's live set fit in 80 MiB (72 aborts), and at 128 V8 let the burst's
# garbage stand: the cgroup peaked at 256-258 MB of 268 MB. At 104: 235-241 MB, with ~24 MiB of heap
# above the abort (measured 2026-10-12, three runs each; 3.0.0 at 128 peaked at 238-252 MB).
# Node 22 sizes V8's heap from the memory the system reports, not from a cgroup's limit: in a
# 256 MiB cgroup on a 16 GB host it allowed 8,195 MiB, so garbage piled up uncollected until the
# kernel killed the instance with every request on it. Capped, V8 collects first; the rest of the
# 256 MiB is the young generation, buffers and the runtime itself. What Cloud Run's instance
# reports is not verified (one that reports 256 MiB gets a default near this cap already): the
# start-up line's heap_limit_mb says what a revision runs with. httpPolicy.ts "Requests in flight
# per instance" has the measurements, and test/http-memory.test.mjs runs http.js with these flags.
# --max-semi-space-size=16 pins the young generation at Node 22's own default, so the heap limit
# is 152 MiB (104 + 3 x 16) on Node 22 AND on Node 24 (176 MiB while the old space was 128). Node 24 sizes the semi-space from the host as well: with
# the old-space cap alone it allowed 320 MiB, over the 256 MiB instance (measured 2026-10-05,
# v8 heap_size_limit; the v2.6.4 Release run, on Node 24, failed http-memory.test.mjs on it).
CMD ["node", "--max-old-space-size=104", "--max-semi-space-size=16", "dist/http.js"]
