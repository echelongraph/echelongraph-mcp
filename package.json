{
  "name": "echelongraph-mcp",
  "version": "2.7.0",
  "mcpName": "io.echelongraph/echelongraph-mcp",
  "description": "MCP server for CVE lookups: EchelonGraph scores, CISA KEV, EPSS, CWE, exploits, version and SBOM checks, vendor advisories, and per-CVE exposure derived from Shodan data. Shodan data is owned by Shodan, which holds its copyright (© Shodan). Keyless.",
  "type": "module",
  "bin": {
    "echelongraph-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "server.json"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "smoke": "node test/smoke.mjs",
    "text-bound:live": "npm run build && node test/text-bound-live.mjs",
    "test": "npm run build && node --test test/*.test.mjs synthetic/*.test.mjs",
    "synthetic": "node synthetic/run.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "cve",
    "vulnerability",
    "vulnerabilities",
    "security",
    "cybersecurity",
    "kev",
    "cisa-kev",
    "epss",
    "nvd",
    "ghsa",
    "cwe",
    "cvss",
    "sbom",
    "lockfile",
    "sca",
    "security-advisories",
    "threat-intelligence",
    "exposure",
    "echelongraph",
    "claude",
    "cursor"
  ],
  "author": "EchelonGraph",
  "license": "MIT",
  "homepage": "https://echelongraph.io/pulse/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echelongraph/echelongraph-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/echelongraph/echelongraph-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5"
  }
}
